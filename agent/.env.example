# Deployed NestJS API. HTTPS is required outside local development.
VIRTUAL_PATROL_API_URL=https://virtual-patrol-platform-8ib6.vercel.app

# One-time token returned by POST /camera-agents. Never commit a real token.
VIRTUAL_PATROL_AGENT_TOKEN=replace-with-one-time-agent-token

# Browser-reachable MediaMTX HLS origin for this site. This is the LAN IP of
# the computer running MediaMTX, or its VPN-reachable address for remote users.
MEDIAMTX_HLS_BASE_URL=http://192.168.1.50:8888

# MediaMTX Control API must listen on localhost only.
MEDIAMTX_API_URL=http://127.0.0.1:9997

# Restrict RTSP destinations. IP cameras inside these approved CIDR ranges can
# be added by admins without changing this file. Use the narrowest subnet(s)
# possible; add VPN camera subnets for remote sites. Do not use 0.0.0.0/0.
CAMERA_ALLOWED_CIDRS=192.168.1.0/24

# Optional exact FQDN/IP allowlist for cameras not covered by an approved CIDR.
# Comma-separated, exact names only; no wildcards.
CAMERA_ALLOWED_HOSTS=camera.example.com

POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000
REQUEST_TIMEOUT_MS=10000
